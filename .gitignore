# Secrets — rule 8. Present from the first commit, before any key exists.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Cached market data — regenerable, and large
data/cache/

# Run outputs. Tracked: nothing but the directory itself.
# experiments.csv is deliberately ignored: it is a local research ledger,
# not a shared artifact, and committing it would invite editing history.
results/*
!results/.gitkeep
# The verdict TEMPLATE is tracked; a filled-in verdict is not. Keeping the
# template beside where the verdict will live means it is found when needed.
!results/*_TEMPLATE.md

# OS / editor
.DS_Store
